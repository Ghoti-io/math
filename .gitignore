docs

# Python
**/__pycache__
*.pyc

# Deterministic atan grids are reconstructed from compact pinned anchors and
# literal seeded answers before tests; full reference outputs stay generated.
/tests/corpus/atan.corpus
/tests/corpus/atan-special.corpus
/tests/corpus/.atan-cache-*

# Deterministic grids are materialized natively and checked against full pins.
/tests/corpus/nearbyint-special.corpus
/tests/corpus/nearbyint.corpus
/tests/corpus/currentint64-special.corpus
/tests/corpus/fdim64-special.corpus
/tests/corpus/fdim.corpus
/tests/corpus/.grid-cache-*

# Exact integer-family state expansion is pinned; per-input literals stay tracked.
/tests/corpus/long-double-nine.corpus
/tests/corpus/.long-double-nine-cache-*

# Reconstructed from compact pinned eleven-family literals.
/tests/corpus/long-double-eleven.corpus
/tests/corpus/.long-double-eleven.*
